NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/yogisdepot?retryWrites=true&w=majority

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173

COOKIE_DOMAIN=
COOKIE_SECURE=false

STORAGE_DRIVER=cloudinary
UPLOAD_DIR=uploads

# Square (Canada / CAD) — use sandbox credentials for local testing
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Exact URL registered in Square Dashboard (e.g. https://api.example.com/api/v1/payments/webhooks/square)
SQUARE_WEBHOOK_NOTIFICATION_URL=

# Required when STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
